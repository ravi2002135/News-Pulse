# --- Server ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# --- Database -------------------------------------------------------------
# Path to the SQLite file the Python pipeline writes. Required; the server
# refuses to start without it.
DATABASE_URL=../newspulse.db

# --- CORS -----------------------------------------------------------------
# Comma-separated origins, or * to allow all (development only).
CORS_ORIGINS=http://localhost:3000

# --- Ingest pipeline ------------------------------------------------------
# How to invoke the Python pipeline. INGEST_CWD must contain the newspulse
# package. Point INGEST_COMMAND at the venv interpreter in production.
INGEST_COMMAND=python3
INGEST_ARGS=-m,newspulse,run
INGEST_CWD=..
INGEST_TIMEOUT_MS=600000
INGEST_LOG_TAIL_LINES=200
# Set false on a read-only deploy where a scheduler owns ingestion.
INGEST_ENABLED=true

# --- Pagination -----------------------------------------------------------
DEFAULT_PAGE_SIZE=25
MAX_PAGE_SIZE=100
